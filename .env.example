# Server-only. Set these in the Netlify and Supabase dashboards.
# Never prefix them with VITE_ and never paste them into HTML or client JS.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=

# Public IndexNow key (8–128 letters, numbers, or dashes). Not a secret:
# the site serves it at /<key>.txt. Do not commit a value. Generate one with
# `npm run indexnow:key`, set INDEXNOW_KEY in Netlify for builds and functions,
# then redeploy so the key file and publish ping use the same value.
INDEXNOW_KEY=
